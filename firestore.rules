rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function isEmployee() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employee')
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Rules
    function isValidUser(data) {
      return data.uid is string && (data.role in ['admin', 'employee', 'client']) &&
             (!('branchId' in data) || data.branchId is string);
    }
    function isValidSelfSignup(data, userId) {
      return data.uid == userId &&
             data.email == request.auth.token.email &&
             data.role == 'client' &&
             data.permissions is map &&
             data.permissions.canEditMeasurements == false &&
             data.permissions.canApprovePayroll == false &&
             data.permissions.canProcessPayments == false &&
             data.permissions.canAdjustInventory == false &&
             data.permissions.canDeleteOrders == false &&
             data.permissions.canViewFinancialReports == false &&
             data.permissions.canManageEmployees == false &&
             data.permissions.canManageSystemSettings == false &&
             data.permissions.canManageInventory == false &&
             data.permissions.canManageClients == false &&
             data.permissions.canManageAccounting == false &&
             data.permissions.canManageOrders == false;
    }
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if (isAdmin() && isValidUser(incoming())) ||
                    (isSignedIn() && request.auth.uid == userId && isValidSelfSignup(incoming(), userId));
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId && 
        existing().role != 'employee' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'branchId'])
      );
    }

    // Measurement Version Rules
    function isValidMeasurementRecord(data) {
      return data.clientId is string && data.version is number && 
             data.measurements is map && data.recordedBy is string;
    }
    match /measurements/{recordId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && isValidMeasurementRecord(incoming());
    }

    // Client Rules
    function isValidClient(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() < 20 &&
             (!('email' in data) || (data.email is string && data.email.size() < 100)) &&
             (!('address' in data) || (data.address is string && data.address.size() < 500)) &&
             (!('householdId' in data) || (data.householdId is string && data.householdId.size() < 128));
    }
    match /clients/{clientId} {
      allow get: if isSignedIn() && (request.auth.uid == clientId || isEmployee());
      allow list: if isEmployee();
      allow create: if isEmployee() && isValidClient(incoming());
      allow update: if isEmployee() && isValidClient(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'address', 'measurements', 'createdAt', 'householdId']);
    }

    // Order Rules
    function isValidOrder(data) {
      return data.clientId is string && data.branchId is string &&
             data.status in ['pending', 'in-progress', 'ready', 'delivered', 'cancelled'] &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.items is list && data.items.size() > 0;
    }
    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isEmployee());
      allow create: if isEmployee() && isValidOrder(incoming());
      allow update: if isEmployee() && isValidOrder(incoming()) && (
        // Action: Update Status
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'auditTrail'])) ||
        // Action: Payment
        (incoming().diff(existing()).affectedKeys().hasOnly(['paidAmount', 'updatedAt', 'auditTrail'])) ||
        // Action: Task status sync
        (incoming().diff(existing()).affectedKeys().hasOnly(['taskStatus'])) ||
        // Action: Full Update (Admin or Item changes)
        (isEmployee() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paidAmount', 'items', 'dueDate', 'updatedAt', 'auditTrail', 'advancePayment', 'taskStatus', 'items']))
      );
    }

    // Sanitized public tracking records. These documents intentionally exclude
    // client names, phone numbers, measurements, prices, payments, and item notes.
    function isValidPublicOrderTracking(data, trackingCode) {
      return data.trackingCode == trackingCode &&
             data.status in ['pending', 'in-progress', 'ready', 'delivered', 'cancelled'] &&
             data.dueDate is string &&
             data.itemCount is number && data.itemCount >= 0 && data.itemCount <= 100 &&
             data.updatedAt is string &&
             data.steps is map &&
             data.steps.registered is bool &&
             data.steps.cutting is bool &&
             data.steps.stitching is bool &&
             data.steps.finishing is bool &&
             data.steps.ready is bool;
    }
    match /publicOrderTracking/{trackingCode} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isEmployee() && isValidPublicOrderTracking(incoming(), trackingCode);
    }

    // Inventory & Fabric Roll Rules
    function isValidFabricRoll(data) {
      return data.inventoryId is string && data.originalLength is number && 
             data.remainingLength is number && data.remainingLength <= data.originalLength;
    }
    match /fabricRolls/{rollId} {
      allow read: if isEmployee();
      allow write: if isEmployee() && isValidFabricRoll(incoming());
    }
    match /inventory/{itemId} {
      allow read: if isEmployee();
      allow write: if isEmployee() && (incoming().name is string && incoming().quantity is number && incoming().quantity >= 0);
    }
    match /inventoryLogs/{logId} {
      allow read: if isEmployee();
      allow create: if isEmployee();
    }

    // Task Rules
    function isValidTask(data) {
      return data.employeeId is string && data.orderId is string &&
             data.type in ['cutting', 'stitching', 'finishing'] &&
             data.status in ['pending', 'in-progress', 'completed'];
    }
    match /tasks/{taskId} {
      allow read: if isEmployee();
      allow create: if isAdmin();
      allow update: if isEmployee() && (
        (incoming().status != existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'startedAt'])) ||
        isAdmin()
      );
    }

    // Employee Rules
    match /employees/{employeeId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    // Financial Document Rules
    function isValidFinDoc(data) {
      return data.type in ['quotation', 'advance-invoice', 'receipt', 'final-invoice', 'expense', 'payroll', 'refund'] &&
             data.amount is number && data.amount >= 0 &&
             (('orderId' in data) || ('clientId' in data) || ('employeeId' in data) || data.type == 'expense');
    }
    match /financialDocuments/{docId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && isValidFinDoc(incoming());
      allow update: if isAdmin();
    }

    // Payroll Record Rules
    match /payrollRecords/{recordId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.employeeId == request.auth.uid);
      allow create, update: if isAdmin();
    }

    // Appointment Rules
    function isValidAppointment(data) {
      return data.clientId is string && data.type in ['measurement', 'trial', 'fitting', 'delivery', 'consultation'] &&
             data.status in ['scheduled', 'completed', 'cancelled', 'no-show'] &&
             data.startTime is string && data.endTime is string;
    }
    match /appointments/{apptId} {
      allow read: if isEmployee() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow create: if isEmployee() && isValidAppointment(incoming());
      allow update: if isEmployee() && isValidAppointment(incoming());
    }

    // Audit Log Rules (Strict Create-Only)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    // Profile change request rules
    function isValidProfileRequest(data) {
      return data.userId is string &&
             data.userName is string &&
             data.requestDate is string &&
             data.suggestedChanges is map &&
             data.status in ['pending', 'approved', 'rejected'];
    }
    match /profileRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
                    incoming().userId == request.auth.uid &&
                    incoming().status == 'pending' &&
                    isValidProfileRequest(incoming());
      allow update: if isAdmin() && isValidProfileRequest(incoming());
    }

    // Client quote request rules
    function isValidQuoteRequest(data) {
      return data.clientId is string &&
             data.clientId == request.auth.uid &&
             data.garmentType is string &&
             data.garmentType.size() > 0 &&
             data.styleNotes is string &&
             data.styleNotes.size() > 0 &&
             data.preferredDueDate is string &&
             data.budgetRange is string &&
             data.measurementSource in ['existing', 'book-measurement', 'enter-later'] &&
             data.status == 'submitted';
    }
    function isValidStaffQuoteRequest(data) {
      return data.clientId is string &&
             data.garmentType is string &&
             data.garmentType.size() > 0 &&
             data.styleNotes is string &&
             data.styleNotes.size() > 0 &&
             data.preferredDueDate is string &&
             data.budgetRange is string &&
             data.measurementSource in ['existing', 'book-measurement', 'enter-later'] &&
             data.status in ['submitted', 'reviewed', 'converted', 'rejected'];
    }
    function isValidQuoteReviewUpdate(data) {
      return data.status in ['reviewed', 'rejected'] &&
             data.updatedAt is string &&
             data.reviewedBy is string &&
             data.reviewNotes is string;
    }
    match /quoteRequests/{requestId} {
      allow create: if (isSignedIn() && isValidQuoteRequest(incoming())) ||
                    (isEmployee() && isValidStaffQuoteRequest(incoming()));
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isEmployee());
      allow update: if isEmployee() &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'reviewedBy', 'reviewNotes']) &&
                    isValidQuoteReviewUpdate(incoming());
    }

    // Branch Rules
    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Accounting & Vendor Rules
    match /vendors/{vendorId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }
    match /vendorBills/{billId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }
    match /accounts/{accountId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /transactions/{txnId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // Notification Rules
    function isValidNotification(data) {
      return data.userId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
             data.type in ['info', 'warning', 'success', 'error'] &&
             data.read is bool &&
             data.channel in ['internal', 'whatsapp', 'sms', 'email'] &&
             data.status in ['pending', 'sent', 'failed'] &&
             data.createdAt is string;
    }
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidNotification(incoming()) &&
                    (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }

    // Recurring Transactions Rules
    match /recurringTransactions/{txnId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Household Rules
    function isValidHousehold(data) {
      return data.name is string && data.name.size() > 0 &&
             data.phone is string && data.phone.size() > 0 &&
             data.address is string && data.address.size() > 0;
    }
    match /households/{householdId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && isValidHousehold(incoming());
      allow update: if isEmployee() && isValidHousehold(incoming());
    }
  }
}
