{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Customer of the tailor shop with measurement data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "householdId": { "type": "string" },
        "measurements": { "$ref": "Measurements" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone"]
    },
    "Measurements": {
      "title": "Measurements",
      "type": "object",
      "properties": {
        "neck": { "type": "number" },
        "chest": { "type": "number" },
        "waist": { "type": "number" },
        "hip": { "type": "number" },
        "shoulder": { "type": "number" },
        "sleeve": { "type": "number" },
        "length": { "type": "number" },
        "inseam": { "type": "number" }
      }
    },
    "MeasurementRecord": {
      "title": "Measurement Record",
      "description": "Versioned measurement data",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "version": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "measurements": { "$ref": "Measurements" },
        "recordedBy": { "type": "string" },
        "notes": { "type": "string" },
        "garmentType": { "type": "string" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Tailoring order with multi-item support and lifecycle tracking",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "branchId": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "description": { "type": "string" },
              "price": { "type": "number" },
              "measurements": { "$ref": "Measurements" },
              "assignedTo": { "type": "string" },
              "status": { "type": "string" },
              "dueDate": { "type": "string", "format": "date" }
            }
          }
        },
        "status": { "type": "string", "enum": ["pending", "in-progress", "ready", "delivered", "cancelled"] },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "advancePayment": { "type": "number" },
        "dueDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Double-entry journal entry",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "debitAccountId": { "type": "string" },
        "creditAccountId": { "type": "string" },
        "reference": { "type": "string" },
        "type": { "type": "string", "enum": ["payroll", "sale", "purchase", "expense", "adjustment"] },
        "metadata": { "type": "object" }
      }
    },
    "FinancialDocument": {
      "title": "Financial Document",
      "description": "Quotations, Invoices, Receipts, and Expenses",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["quotation", "advance-invoice", "final-invoice", "receipt", "refund", "expense", "payroll"] },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "employeeId": { "type": "string" },
        "orderId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["draft", "issued", "paid", "cancelled", "void"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "auditTrail": { "type": "array", "items": { "type": "string" } }
      }
    },
    "PayrollRecord": {
      "title": "Payroll Record",
      "description": "Individual monthly salary disbursement details",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "month": { "type": "string" },
        "baseSalary": { "type": "number" },
        "bonuses": { "type": "array", "items": { "type": "object" } },
        "deductions": { "type": "array", "items": { "type": "object" } },
        "netSalary": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "approved", "paid", "cancelled"] },
        "payoutDate": { "type": "string", "format": "date" },
        "transactionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FabricRoll": {
      "title": "Fabric Roll",
      "description": "Individual roll of fabric tracking length",
      "type": "object",
      "properties": {
        "inventoryId": { "type": "string" },
        "rollNumber": { "type": "string" },
        "originalLength": { "type": "number" },
        "usedLength": { "type": "number" },
        "remainingLength": { "type": "number" },
        "purchaseDate": { "type": "string", "format": "date" }
      }
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Stock items with roll tracking support",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "enum": ["meters", "yards", "pieces", "units"] },
        "minLevel": { "type": "number" },
        "pricePerUnit": { "type": "number" },
        "isRollTracked": { "type": "boolean" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "InventoryLog": {
      "title": "Inventory Log",
      "description": "Audit trail for stock changes",
      "type": "object",
      "properties": {
        "inventoryId": { "type": "string" },
        "rollId": { "type": "string" },
        "type": { "type": "string", "enum": ["usage", "restock", "adjustment"] },
        "quantity": { "type": "number" },
        "actorId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Client scheduled visits",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["measurement", "trial", "fitting", "delivery", "consultation"] },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled", "no-show"] },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "assignedTo": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "System-wide activity tracker",
      "type": "object",
      "properties": {
        "actorId": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Branch": {
      "title": "Branch",
      "description": "Business location",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "phone": { "type": "string" },
        "managerId": { "type": "string" }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "App user roles and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "employee", "client"] },
        "employeeId": { "type": "string" },
        "clientId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ProfileRequest": {
      "title": "Profile Change Request",
      "description": "Employee request to update their profile",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "requestDate": { "type": "string", "format": "date-time" },
        "suggestedChanges": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" }
          }
        },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminResponse": { "type": "string" }
      }
    },
    "QuoteRequest": {
      "title": "Quote Request",
      "description": "Client-submitted bespoke inquiry before order creation",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "garmentType": { "type": "string" },
        "styleNotes": { "type": "string" },
        "preferredDueDate": { "type": "string", "format": "date" },
        "budgetRange": { "type": "string" },
        "measurementSource": { "type": "string", "enum": ["existing", "book-measurement", "enter-later"] },
        "inspirationNotes": { "type": "string" },
        "status": { "type": "string", "enum": ["submitted", "reviewed", "converted", "rejected"] },
        "reviewedBy": { "type": "string" },
        "reviewNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "garmentType", "styleNotes", "preferredDueDate", "budgetRange", "measurementSource", "status"]
    },
    "PublicOrderTracking": {
      "title": "Public Order Tracking",
      "description": "Sanitized public tracking document for unauthenticated order lookup",
      "type": "object",
      "properties": {
        "trackingCode": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "ready", "delivered", "cancelled"] },
        "dueDate": { "type": "string", "format": "date" },
        "itemCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "steps": {
          "type": "object",
          "properties": {
            "registered": { "type": "boolean" },
            "cutting": { "type": "boolean" },
            "stitching": { "type": "boolean" },
            "finishing": { "type": "boolean" },
            "ready": { "type": "boolean" }
          }
        }
      },
      "required": ["trackingCode", "status", "dueDate", "itemCount", "updatedAt", "steps"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System alerts and notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "warning", "success", "error"] },
        "read": { "type": "boolean" },
        "channel": { "type": "string", "enum": ["internal", "whatsapp", "sms", "email"] },
        "status": { "type": "string", "enum": ["pending", "sent", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "read", "channel", "status", "createdAt"]
    },
    "RecurringTransaction": {
      "title": "Recurring Transaction",
      "description": "Template for automated recurring payments or bills",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly"] },
        "type": { "type": "string", "enum": ["expense", "revenue"] },
        "category": { "type": "string" },
        "debitAccountId": { "type": "string" },
        "creditAccountId": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "lastProcessed": { "type": "string", "format": "date" },
        "nextDueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["active", "paused"] }
      }
    },
    "Household": {
      "title": "Household",
      "description": "Family or group of clients sharing address and contact",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "primaryContactName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "address"]
    }
  },
  "firestore": {
    "/clients/{clientId}": { "schema": "Client", "description": "Individual client records" },
    "/measurements/{recordId}": { "schema": "MeasurementRecord", "description": "Versioned measurements" },
    "/orders/{orderId}": { "schema": "Order", "description": "Work orders for tailoring" },
    "/inventory/{itemId}": { "schema": "InventoryItem", "description": "Stock tracking" },
    "/fabricRolls/{rollId}": { "schema": "FabricRoll", "description": "Individual fabric rolls" },
    "/inventoryLogs/{logId}": { "schema": "InventoryLog", "description": "Stock usage history" },
    "/appointments/{apptId}": { "schema": "Appointment", "description": "Client visits" },
    "/auditLogs/{logId}": { "schema": "AuditLog", "description": "Security audit trail" },
    "/branches/{branchId}": { "schema": "Branch", "description": "Business locations" },
    "/vendors/{vendorId}": { "schema": "Vendor", "description": "Supplier information" },
    "/vendorBills/{billId}": { "schema": "VendorBill", "description": "Purchasing records" },
    "/accounts/{accountId}": { "schema": "Account", "description": "Chart of Accounts" },
    "/transactions/{txnId}": { "schema": "Transaction", "description": "Financial journal" },
    "/employees/{empId}": { "schema": "Employee", "description": "HR records" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Financial flows" },
    "/users/{uid}": { "schema": "UserProfile", "description": "User roles and permissions" },
    "/profileRequests/{requestId}": { "schema": "ProfileRequest", "description": "Employee profile change requests" },
    "/quoteRequests/{requestId}": { "schema": "QuoteRequest", "description": "Client bespoke quote inquiries" },
    "/publicOrderTracking/{trackingCode}": { "schema": "PublicOrderTracking", "description": "Sanitized public order tracking records" },
    "/notifications/{notifId}": { "schema": "Notification", "description": "System alerts" },
    "/recurringTransactions/{txnId}": { "schema": "RecurringTransaction", "description": "Automated ledger entries" },
    "/households/{householdId}": { "schema": "Household", "description": "Group of clients" },
    "/payrollRecords/{recordId}": { "schema": "PayrollRecord", "description": "Salary disbursement history" },
    "/financialDocuments/{docId}": { "schema": "FinancialDocument", "description": "Accounting documents" }
  }
}
