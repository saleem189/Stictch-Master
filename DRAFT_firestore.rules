rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/employees/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'admin';
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Client Rules
    function isValidClient(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() < 20 &&
             (!('email' in data) || (data.email is string && data.email.size() < 100));
    }
    match /clients/{clientId} {
      allow get: if isSignedIn() && (request.auth.uid == clientId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidClient(incoming()) && (request.auth.uid == clientId || isAdmin()) &&
                    incoming().keys().hasAll(['name', 'phone']) && incoming().keys().size() >= 2;
      allow update: if isSignedIn() && isValidClient(incoming()) && (request.auth.uid == clientId || isAdmin()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'measurements']);
    }

    // Order Rules
    function isValidOrder(data) {
      return data.clientId is string && data.clientId.size() < 100 &&
             data.status in ['pending', 'cutting', 'stitching', 'finished', 'delivered'] &&
             data.totalAmount is number && data.totalAmount >= 0;
    }
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidOrder(incoming()) &&
                    incoming().keys().hasAll(['clientId', 'status', 'totalAmount']) && incoming().keys().size() >= 3;
      allow update: if isAdmin() && isValidOrder(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paidAmount', 'items', 'assignedTo', 'dueDate']);
    }

    // Inventory Rules
    function isValidInventory(data) {
      return data.name is string && data.quantity is number && data.quantity >= 0;
    }
    match /inventory/{itemId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidInventory(incoming());
    }

    // Vendor Rules
    match /vendors/{vendorId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /vendorBills/{billId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Accounting Rules
    match /accounts/{accountId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /transactions/{txnId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && incoming().debitAccountId != incoming().creditAccountId;
    }

    // Employee Rules
    match /employees/{empId} {
      allow read: if isSignedIn() && (request.auth.uid == empId || isAdmin());
      allow create: if isAdmin(); // Initial admin bootstrap might need manual help or first user becomes admin
      allow update: if isAdmin();
    }
  }
}
